local function UpdatePlayerDropdown()
	for _, child in ipairs(dropFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	local playersList = Players:GetPlayers()
	dropFrame.CanvasSize = UDim2.new(0, 0, 0, #playersList * 30 + 30)
	
	-- ตัวเลือก ALL
	local allBtn = Instance.new("TextButton", dropFrame)
	allBtn.Size = UDim2.new(1, 0, 0, 30)
	allBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	allBtn.Text = "[ ALL PLAYERS ]"
	allBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
	allBtn.Font = Enum.Font.GothamBold
	allBtn.TextSize = 12
	allBtn.ZIndex = 11
	allBtn.MouseButton1Click:Connect(function()
		targetBox.Text = "ALL"
		dropFrame.Visible = false
	end)
	
	for _, p in ipairs(playersList) do
		local pBtn = Instance.new("TextButton", dropFrame)
		pBtn.Size = UDim2.new(1, 0, 0, 30)
		pBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
		pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
		pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		pBtn.Font = Enum.Font.Gotham
		pBtn.TextSize = 12
		pBtn.ZIndex = 11
		pBtn.MouseButton1Click:Connect(function()
			targetBox.Text = p.Name
			dropFrame.Visible = false
		end)
	end
end

dropdownBtn.MouseButton1Click:Connect(function()
	dropFrame.Visible = not dropFrame.Visible
	if dropFrame.Visible then UpdatePlayerDropdown() end
end)

-- ฟังก์ชันค้นหาผู้เล่นจากชื่อย่อ
local function GetTargetName(input)
	if input == "" or input:upper() == "ALL" then return "ALL" end
	local lowerInput = string.lower(input)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(p.Name), lowerInput) or string.find(string.lower(p.DisplayName), lowerInput) then
			return p.Name
		end
	end
	return input
end

-- ฟังก์ชันส่งข้อความสัญญาณลับ
local function SendDevSignal(cmd, extraData)
	local rawTarget = targetBox.Text
	local matchedTarget = GetTargetName(rawTarget)
	
	local signalMessage = "[DEV_CMD]:" .. cmd .. ":" .. matchedTarget
	if extraData then
		signalMessage = signalMessage .. ":" .. extraData
	end
	
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if channel then channel:SendAsync(signalMessage) end
		else
			ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(signalMessage, "All")
		end
	end)
end

local function CreateDevBtn(name, text, posY, btnColor, callback)
	local btn = Instance.new("TextButton", main)
	btn.Name = name
	btn.Size = UDim2.new(1, -30, 0, 40)
	btn.Position = UDim2.new(0, 15, 0, posY)
	btn.BackgroundColor3 = btnColor
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	btn.MouseButton1Click:Connect(function()
		callback()
		local origColor = btn.BackgroundColor3
		btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = origColor}):Play()
	end)
end

